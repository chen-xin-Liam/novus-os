#ifndef NOVUS_BITSET
#define NOVUS_BITSET
#include "__novus_rt.h"
namespace std {
  template <unsigned long N> class bitset {
    unsigned long long bits;
  public:
    bitset():bits(0){}
    bitset(unsigned long long v):bits(v){}
    bool test(unsigned long i) const { return i<N && ((bits>>i)&1ULL)!=0; }
    bool operator[](unsigned long i) const { return test(i); }
    bitset& set(unsigned long i){ if(i<N) bits|=(1ULL<<i); return *this; }
    bitset& reset(unsigned long i){ if(i<N) bits&=~(1ULL<<i); return *this; }
    unsigned long count() const { unsigned long c=0; for(unsigned long i=0;i<N;i++) if(bits&(1ULL<<i))c++; return c; }
    unsigned long long to_ulong() const { return bits; }
  };
}
#endif

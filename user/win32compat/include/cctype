#ifndef NOVUS_CCTYPE
#define NOVUS_CCTYPE
namespace std {
  inline int isalpha(int c){ return ((c>='A'&&c<='Z')||(c>='a'&&c<='z'))?1:0; }
  inline int isdigit(int c){ return (c>='0'&&c<='9')?1:0; }
  inline int isalnum(int c){ return isalpha(c)||isdigit(c); }
  inline int isspace(int c){ return c==' '||c=='\t'||c=='\n'||c=='\r'?1:0; }
  inline int toupper(int c){ return c>='a'&&c<='z'?c-32:c; }
  inline int tolower(int c){ return c>='A'&&c<='Z'?c+32:c; }
}
using std::isalpha; using std::isdigit; using std::isalnum; using std::isspace; using std::toupper; using std::tolower;
#endif

;; ============================================================
;; Nuomi 标准库示例 —— 高阶函数与列表工具
;;   运行：nuomi samples/stdlib.nuomi
;; ============================================================

;; ---------- map：逐元素映射 ----------
(println "map平方:" (map (lambda (v) (* v v)) [1 2 3 4 5]))
(println "map字符串:" (map (lambda (s) (str s "!")) ["hi" "yo"]))

;; ---------- filter：筛选 ----------
(println "大于3的:" (filter (lambda (v) (> v 3)) [1 2 3 4 5 6]))
(println "偶数:" (filter (lambda (v) (= (% v 2) 0)) (range 1 11)))

;; ---------- reduce：归约 ----------
(println "求和:" (reduce + [1 2 3 4 5]))
(println "带初值求和:" (reduce + 100 [1 2 3]))
(println "自定义:" (reduce (lambda (acc v) (+ acc (* v v))) 0 [1 2 3 4]))

;; ---------- range：生成序列 ----------
(println "range 5:" (range 5))
(println "range 2..6:" (range 2 6))
(println "range 步长2:" (range 0 10 2))
(println "range 倒序:" (range 5 0 -1))

;; ---------- 类型判断 ----------
(println "类型:" (number? 1) (string? "a") (list? '(1)) (vector? [1]) (function? car) (bool? true))

;; ---------- 数学函数 ----------
(println "数学:" (abs -7) (floor 3.9) (ceil 3.1) (round 3.5) (sqrt 144) (pow 3 4))
(println "最值:" (min 5 2 8) (max 5 2 8))

;; ---------- 序列工具 ----------
(println "last:" (last '(1 2 3)))
(println "reverse:" (reverse [1 2 3]))
(println "append:" (append [1 2] [3 4]))
(println "null?:" (null? []) (null? [1]) (null? '()))
(println "member?:" (member? 2 [1 2 3]) (member? 9 [1 2 3]))

;; ---------- assoc：关联表 ----------
(define alist (assoc (assoc '() 'apple 3) 'banana 5))
(println "assoc 表:" alist)
(println "更新键:" (assoc alist 'apple 10))

;; ============================================================
;; 综合示例：素数筛（用到 letrec + filter + range）
;; ============================================================
(define (prime? n)
  (if (< n 2)
      false
      (letrec ((check (lambda (d)
                        (if (> (* d d) n)
                            true
                            (if (= (% n d) 0)
                                false
                                (check (+ d 1)))))))
        (check 2))))

(println "100以内素数:" (filter prime? (range 2 100)))

;; ============================================================
;; 综合示例：闭包计数器（用到 let 的状态捕获）
;; ============================================================
(define (make-counter)
  (let ((n 0))
    (lambda ()
      (set! n (+ n 1))
      n)))

(define c1 (make-counter))
(define c2 (make-counter))
(println "c1:" (c1) (c1) (c1))
(println "c2:" (c2))

;; ============================================================
;; 综合示例：深递归（原本约 500 层就栈溢出，现支持数千层）
;; ============================================================
(define (depth n) (if (< n 1) 0 (+ 1 (depth (- n 1)))))
(println "递归 3000 层:" (depth 3000))
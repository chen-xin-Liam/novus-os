# Novus OS - M1 base configuration
#
# Plain shell-style variables consumed by the top-level Makefile via
# '-include'. A full Kconfig parser with menuconfig support is planned
# for a later milestone; for M1 this file is the single source of build
# configuration and mirrors the declarations in the top-level Kconfig.

# Target architecture.
CONFIG_NOVUS_ARCH=x86_64

# Minimum guest/host memory (MB) the kernel expects at boot.
# 'make run' defaults to MEM=4G, well above this floor.
CONFIG_NOVUS_MIN_MEMORY_MB=2048

# VGA text-mode output during early boot.
CONFIG_NOVUS_BOOT_VGA=y

# Serial (COM1) debug output.
CONFIG_NOVUS_DEBUG_SERIAL=y

# Marker for the M0 milestone build scope.
CONFIG_NOVUS_BUILD_M0=y

# Disable the A core (BSP): it skips the early self-check and sleeps right
# after firmware handoff, and the B core (AP) loads and runs the main
# kernel (README 2.2 step 7). The M8 settings UI can flip the matching
# shared-memory flag at runtime.
CONFIG_NOVUS_A_CORE_DISABLE=n

# SMP: assemble the AP trampoline and wake the B core during boot.
# 'make run' boots QEMU with -smp 2 (AB dual-core, README part 2).
CONFIG_NOVUS_SMP=y

# NovusFS filesystem core (M2, README part 4).
CONFIG_NOVUS_NOVUSFS=y

# NovusFS write-ahead log (M2, README 4.2.1). Requires CONFIG_NOVUS_NOVUSFS.
CONFIG_NOVUS_WAL=y

# NovusFS integrity tree (M3, README 4.2.2): Merkle root in both
# superblock copies, verified by the A core in the boot stage.
CONFIG_NOVUS_MERKLE=y

# Novus kernel module loader (M3, README part 5): SHA-256 digest plus
# Ed25519 verification against the built-in root keys.
CONFIG_NOVUS_NKM=y

# Boot-stage installer (M3): GPT + ESP + NovusFS onto a target disk.
CONFIG_NOVUS_INSTALLER=y

# Mochi language and its NUC toolchain (user/mochi submodule): compiles a
# .mochi source into a NUC application and packs it into the live ESP as
# APPS/DEMO.NUC. Requires the submodule to be checked out.
CONFIG_USER_MOCHI=y
CONFIG_USER_MOCHI_NUCUTIL=y

# M7 C++98 compiler. `make` builds the host tool; `make run` compiles and
# stages the Hello sample as APPS/DEMO.NUC for the boot-stage loader.
CONFIG_USER_CPPCC=y

# M4: scheduler, ring 3, syscalls and the NUC loader.
CONFIG_NOVUS_SCHED=y

# M5: NovusDisplay (README part 11): the linear-framebuffer HAL, the 2D
# renderer, the built-in font, PS/2 input polling and the demo desktop.
CONFIG_NOVUS_DISPLAY=y

# M5: NovusGUI widget library (window/button/textbox/slider/list/tree).
# Requires CONFIG_NOVUS_DISPLAY.
CONFIG_NOVUS_GUI=y

# M6: message IPC between processes (ports, checksums, blocking receive).
# Requires CONFIG_NOVUS_SCHED.
CONFIG_NOVUS_IPC=y
CONFIG_NOVUS_PCI=y
CONFIG_NOVUS_NET=y

# M6: Novus-WM window manager and the GUI protocol server. Requires
# CONFIG_NOVUS_GUI and CONFIG_NOVUS_IPC.
CONFIG_NOVUS_WM=y

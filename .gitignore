# ------------------------------------------------------------------
# Novus OS build artifacts (M0 build system)
# ------------------------------------------------------------------

# Build system output: object files (build/), the final EFI image and
# QEMU runtime state (out/), and the FAT ESP staging directory (esp/).
build/
out/
esp/

# The host signing tool is a cargo project; its own target directory is
# not a Novus artifact.
tools/nkmgen/target/

# Rust crate (lib/novuslib-rs) local cargo target dir; the library that
# lands in build/rust is already covered by build/ above.
lib/novuslib-rs/target/

# Compiler/linker intermediates and EFI binaries
*.o
*.efi

# OVMF non-volatile variable copies created by scripts/run.sh
OVMF_VARS*.fd

# ------------------------------------------------------------------
# Generic C/toolchain artifacts
# ------------------------------------------------------------------

# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo
